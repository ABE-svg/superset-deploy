# =========================================================================
# Apache Superset - environment template
# =========================================================================
# DO NOT fill this file in and DO NOT rename it to .env in the repository.
# `.env` is gitignored precisely so that real credentials never reach GitHub.
#
# In production you do not create a .env file by hand at all. You paste these
# keys and values into Dokploy, under your application's "Environment" tab.
# Dokploy writes them to a .env file next to docker-compose.yml on the server,
# which is what `env_file: .env` in the compose file reads.
#
# Copy this file only for a local test run (see README, "Testing locally").
# =========================================================================


# =========================================================================
# 1. SECRETS - never commit, never reuse between environments
# =========================================================================

# Encrypts session cookies and the stored passwords of the database connections
# you create inside Superset.
#
# Generate one with:      openssl rand -hex 32
#
# WARNING: changing this after the first deploy makes every stored database
# password undecryptable and forces you to run `superset re-encrypt-secrets`.
# Choose it once, before the first deploy.
SUPERSET_SECRET_KEY=CHANGE_ME

# Password of the OVHcloud Managed PostgreSQL user. Shown only once in the OVH
# control panel when you create or reset the user.
POSTGRES_PASSWORD=CHANGE_ME

# Password of the first Superset administrator account, created automatically on
# the first deploy. Change it in the Superset UI afterwards.
ADMIN_PASSWORD=CHANGE_ME


# =========================================================================
# 2. REQUIRED - the deploy fails with an explicit error if any is missing
# =========================================================================

# --- OVHcloud Managed PostgreSQL -----------------------------------------
# From: Public Cloud > Databases > your service > General information.
# Use the PRIVATE (vRack) endpoint, not the public one.
POSTGRES_HOST=postgresql-xxxxxxxx.database.cloud.ovh.net

# NOT 5432. OVHcloud assigns a non-standard port, usually in the 20000 range.
# Read the exact value from the control panel. There is no default on purpose:
# a wrong port produces a timeout that looks like a firewall problem.
POSTGRES_PORT=20184

# The database and user you created in the OVH control panel.
POSTGRES_DB=superset
POSTGRES_USER=avnadmin

# --- First administrator account -----------------------------------------
ADMIN_EMAIL=you@example.org


# =========================================================================
# 3. CONFIGURATION - sensible defaults, change only if you need to
# =========================================================================

# Pinned Superset version. Both the image tag and the Dockerfile build argument.
# Never use `latest`: on 2026-08-31 it silently moved from 6.0.0 to 6.1.0, which
# would have triggered an unrequested database migration.
SUPERSET_VERSION=6.1.0

# --- Database TLS ---------------------------------------------------------
# require     encrypt, do not validate the server certificate (default)
# verify-full encrypt and validate; also set POSTGRES_SSLROOTCERT
POSTGRES_SSLMODE=require
# Path INSIDE the container to the CA certificate from the OVH control panel.
# Only needed for verify-ca / verify-full.
# POSTGRES_SSLROOTCERT=/app/pythonpath/ca.pem

# --- First administrator account -----------------------------------------
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User

# --- Web server -----------------------------------------------------------
# Gunicorn worker processes. Rule of thumb: (2 x vCPU) + 1.
# 5 suits the recommended 2 vCPU instance. The image defaults to 1, which would
# serialise every request.
SERVER_WORKER_AMOUNT=5
SERVER_THREADS_AMOUNT=20
# Seconds before Gunicorn kills a request. Must stay ABOVE
# SUPERSET_WEBSERVER_TIMEOUT, or long SQL Lab queries die without a useful error.
GUNICORN_TIMEOUT=330
SUPERSET_WEBSERVER_TIMEOUT=300
# Recycle workers periodically to bound the effect of any memory leak.
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=100

# --- Celery ---------------------------------------------------------------
# Concurrent background tasks per worker container.
CELERYD_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=1200

# --- Query limits ---------------------------------------------------------
ROW_LIMIT=50000
SQL_MAX_ROW=100000

# --- Resource limits ------------------------------------------------------
# Sized for a 2 vCPU / 8 GB instance, leaving room for the OS, Docker and
# Dokploy itself. Raise these together with the instance, not on their own.
SUPERSET_MEMORY_LIMIT=3g
WORKER_MEMORY_LIMIT=2g
BEAT_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=768m
REDIS_MAXMEMORY=512mb

# --- Miscellaneous --------------------------------------------------------
APP_NAME=Superset
TZ=Europe/Paris
SUPERSET_LOG_LEVEL=INFO
SESSION_LIFETIME_SECONDS=43200


# =========================================================================
# 4. OPTIONAL
# =========================================================================

# Required only for the deck.gl map charts.
# MAPBOX_API_KEY=

# Set to false ONLY for a local plain-HTTP test. In production this must stay
# true, otherwise the session cookie can travel unencrypted.
# SESSION_COOKIE_SECURE=true

# Redis lives on the internal Docker network; these rarely need changing.
# REDIS_HOST=redis
# REDIS_PORT=6379
