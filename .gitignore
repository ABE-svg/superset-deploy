# ---------------------------------------------------------------------------
# Secrets — NEVER commit. The real file lives only on the server.
#
# Note: docker/.env is intentionally NOT ignored. It holds non-secret defaults
# and must be present in a fresh clone, because docker-compose.yml declares it
# as a required env_file. Secrets go in docker/.env-local, which is loaded after
# it and overrides it.
# ---------------------------------------------------------------------------
docker/.env-local
*.pem
*.key
*.p12

# Certbot certificates and challenges (generated at runtime)
conf/certbot/

# Nginx logs (bind mount)
logs/

# Backups left behind by edits made in production
*.bak
*.bak-*
*.old

# Database dumps and backup archives (see scripts/backup-db.sh)
backups/
*.dump
*.sql
*.tgz

# Database CA certificate downloaded from the OVHcloud control panel
docker/ca.pem

# Python
__pycache__/
*.pyc

# System
.DS_Store
