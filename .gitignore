# ---------------------------------------------------------------------------
# SECRETS - never commit.
#
# .env holds the real secret key, the database password and the admin password.
# In production it is written on the server by Dokploy from the values you type
# into its Environment tab; it must never exist in this repository.
#
# Only .env.example, which contains placeholders, is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
*.crt

# ---------------------------------------------------------------------------
# Database dumps and backups (see scripts/backup-db.sh).
# These contain your full metadata database, users included.
# ---------------------------------------------------------------------------
backups/
*.dump
*.sql
*.sql.gz
*.tgz
*.tar.gz

# Editor backups left behind by edits made on a server
*.bak
*.bak-*
*.old
*~

# Python
__pycache__/
*.py[cod]

# System
.DS_Store
Thumbs.db
