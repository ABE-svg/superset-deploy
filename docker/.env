# ---------------------------------------------------------------------------
# NON-SECRET DEFAULTS. THIS FILE IS COMMITTED TO GIT.
#
# Adapted from https://github.com/apache/superset/blob/6.1.0/docker/.env
#
# Every secret and every per-deployment value (database host, credentials,
# secret key, domain) belongs in docker/.env-local, which is gitignored and
# loaded AFTER this file, so anything set there wins.
#
# NEVER put a real credential in this file.
# ---------------------------------------------------------------------------

# Allow python to print() in docker
PYTHONUNBUFFERED=1

COMPOSE_PROJECT_NAME=superset

# Production: no auto-reload, no debugger, no example data.
# (Upstream ships DEV_MODE=true / FLASK_DEBUG=true / SUPERSET_LOAD_EXAMPLES=yes.)
DEV_MODE=false
FLASK_DEBUG=false
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_LOG_LEVEL=info

# Database engine. The metadata database is OVHcloud Managed PostgreSQL, an
# external service — there is no `db` container in this deployment.
#
# DATABASE_HOST, DATABASE_PORT, DATABASE_DB, DATABASE_USER and DATABASE_PASSWORD
# are deliberately NOT set here. They are per-deployment values and they live in
# docker/.env-local. superset_config_docker.py fails fast with a clear message if
# any of them is missing, rather than silently building a broken connection URI.
DATABASE_DIALECT=postgresql

# Superset reads its config from this path; the bind mount ./docker:/app/docker
# is what puts superset_config_docker.py there.
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev

# Redis stays a local container: cache, Celery broker and distributed locks.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1

SUPERSET_APP_ROOT="/"
SUPERSET_PORT=8088
MAPBOX_API_KEY=''

# Build-time arguments of the OFFICIAL Superset Dockerfile. They have no effect
# in this deployment — our worker image ships Chromium already, built by
# docker-browser/Dockerfile. Kept only to stay aligned with the upstream .env.
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=false
