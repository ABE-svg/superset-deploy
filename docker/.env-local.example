# ======================================================================
# PRODUCTION CONFIGURATION - OVERRIDES THE VALUES IN docker/.env
# ======================================================================
# Copy this to docker/.env-local and fill in the real values.
# docker/.env-local is in .gitignore and must NEVER be committed.

# ======== SUPERSET VERSION ========
# Pinned. TAG (the official image) and BROWSER_TAG (our image with Chromium)
# move together. To move to a new version: see README.md > "Version upgrade".
TAG=6.1.0
BROWSER_TAG=6.1.0

# Development mode OFF
DEV_MODE=false
SUPERSET_BUILD_TARGET=lean

# Environment and debugging
SUPERSET_ENV=production
FLASK_ENV=production
FLASK_DEBUG=false
SUPERSET_LOG_LEVEL=info

# No example data in production
SUPERSET_LOAD_EXAMPLES=no

# WARNING: this variable is a build arg of the OFFICIAL Superset Dockerfile and
# has no effect in this setup — here the browser comes ready-made in our own
# image, docker-browser/Dockerfile. Kept only to stay in sync with the
# upstream .env.
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=false
CYPRESS_CONFIG=false

# ======== SECRET KEY (CRITICAL!) ========
# Generate a new one with: python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=<GENERATE-A-UNIQUE-KEY>

# ======== METADATA DATABASE - OVHcloud Managed PostgreSQL ========
# There is no `db` container. These values come from the service page in the
# OVHcloud control panel. All five are mandatory: superset_config_docker.py
# refuses to start with a clear error if any is missing.
#
# Take the host exactly as shown in the control panel (a *.database.cloud.ovh.net
# name). Your instance's public IPv4 must be in the service's authorised IPs, or
# the connection is refused before authentication.
DATABASE_HOST=<postgresql-xxxxxxxx.database.cloud.ovh.net>
# NOT 5432. OVHcloud assigns a non-standard port, typically in the 20000 range.
DATABASE_PORT=<20184>
DATABASE_DB=<superset>
DATABASE_USER=<superset>
DATABASE_PASSWORD=<PASSWORD-FROM-THE-OVH-CONTROL-PANEL>

# TLS to the database is mandatory over the public internet.
#   require     encrypt without verifying the server certificate (default)
#   verify-full encrypt and verify; also set DATABASE_SSLROOTCERT
DATABASE_SSLMODE=require
# Path INSIDE the container to the CA certificate downloaded from the control
# panel. Only needed for verify-ca / verify-full. Mount it via docker-compose.
# DATABASE_SSLROOTCERT=/app/docker/ca.pem

# ======== INITIAL ADMIN USER ========
# Used by docker-init.sh on first boot to create the `admin` account.
# Change it here BEFORE the first `docker compose up`, then change the password
# in the UI afterwards.
ADMIN_PASSWORD=<CHOOSE-A-STRONG-PASSWORD>

# ======== HOSTS ========
SUPERSET_WEBSERVER_DOMAINS=<SERVER-IP>,<YOUR-DOMAIN>
GLOBAL_ASYNC_QUERIES_WEBSOCKET_URL=ws://<YOUR-DOMAIN>:8080/

# ======== WEBDRIVER (Alerts & Reports) ========
# This MUST be the INTERNAL docker network URL. If it points at the public
# domain, the worker goes out to the internet, comes back in through nginx and
# starts validating TLS — at which point every alert breaks along with the
# certificate (SSL: CERTIFICATE_VERIFY_FAILED), including the ones that take no
# screenshot at all. The public link used in the email is a separate setting
# (WEBDRIVER_BASEURL_USER_FRIENDLY, in superset_config_docker.py).
SUPERSET_WEBDRIVER_BASEURL=http://superset:8088/
SQLALCHEMY_TRACK_MODIFICATIONS=false

# ======== ALERTS & REPORTS ========
# OFF. This deployment has no SMTP server, so a report would have nowhere to be
# delivered. Leaving it off is not a limitation of the stack: the capability is
# fully present and never blocks a deploy.
#
# Turning it on requires all three of:
#   1. ALERT_REPORTS=true here
#   2. an SMTP server (or Slack) configured in superset_config_docker.py
#   3. the Chromium worker image, for chart screenshots:
#        docker build --build-arg SUPERSET_VERSION=6.1.0 -t superset-browser:6.1.0 docker-browser/
#        docker compose --profile reports up -d
ALERT_REPORTS=false
