{
  "algorithm": "default",
  "token": {
    "brandAppName": "Astecha Dashboard",
    "brandLogoAlt": "Astecha",
    "brandLogoUrl": "/static/assets/astecha/astecha-logo-light.png",
    "brandLogoHeight": "22px",
    "brandLogoMargin": "19px 0",
    "brandLogoHref": "/",

    "colorPrimary": "#270173",
    "colorLink": "#3B0FAA",
    "colorInfo": "#2044DC",
    "colorSuccess": "#4E7A63",
    "colorWarning": "#F59E0B",
    "colorError": "#D21D1E",
    "colorTextBase": "#121219",
    "borderRadius": 6,

    "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif",
    "fontFamilyCode": "'Fira Code', 'Courier New', monospace",
    "fontUrls": [
      "https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap"
    ],
    "colorEditorSelection": "#EFEAFB"
  },
  "echartsOptionsOverrides": {
    "textStyle": { "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif" },
    "tooltip": {
      "borderWidth": 0,
      "textStyle": { "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif" },
      "extraCssText": "box-shadow: 0 4px 16px rgba(18,18,25,0.14); border-radius: 6px;"
    },
    "legend": {
      "icon": "circle",
      "itemWidth": 10,
      "itemHeight": 10,
      "textStyle": { "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif" }
    }
  },
  "echartsOptionsOverridesByChartType": {
    "echarts_timeseries_bar": { "series": { "itemStyle": { "borderRadius": [2, 2, 0, 0] } } },
    "echarts_timeseries_line": { "series": { "lineStyle": { "width": 2.5 } } },
    "echarts_timeseries_smooth": { "series": { "lineStyle": { "width": 2.5 } } },
    "echarts_area": { "series": { "lineStyle": { "width": 2 } } },
    "pie": { "series": { "itemStyle": { "borderColor": "#FFFFFF", "borderWidth": 2 } } },
    "treemap_v2": { "series": { "itemStyle": { "borderColor": "#FFFFFF", "borderWidth": 2, "gapWidth": 2 } } },
    "sunburst_v2": { "series": { "itemStyle": { "borderColor": "#FFFFFF", "borderWidth": 2 } } }
  }
}
