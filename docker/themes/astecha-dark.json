{
  "algorithm": "dark",
  "token": {
    "brandAppName": "Astecha Dashboard",
    "brandLogoAlt": "Astecha",
    "brandLogoUrl": "/static/assets/astecha/astecha-logo-dark.png",
    "brandLogoHeight": "22px",
    "brandLogoMargin": "19px 0",
    "brandLogoHref": "/",
    "colorPrimary": "#AD95E8",
    "colorLink": "#AD95E8",
    "colorInfo": "#88AAFF",
    "colorSuccess": "#7FA98F",
    "colorWarning": "#F5B54A",
    "colorError": "#F87475",
    "colorTextBase": "#F5F5F5",
    "borderRadius": 6,
    "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif",
    "fontFamilyCode": "'Fira Code', 'Courier New', monospace",
    "fontUrls": [
      "https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap"
    ],
    "colorEditorSelection": "#3B2A6A"
  },
  "echartsOptionsOverrides": {
    "textStyle": {
      "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif"
    },
    "tooltip": {
      "borderWidth": 0,
      "textStyle": {
        "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif"
      },
      "extraCssText": "box-shadow: 0 4px 16px rgba(0,0,0,0.45); border-radius: 6px;"
    },
    "legend": {
      "icon": "circle",
      "itemWidth": 10,
      "itemHeight": 10,
      "textStyle": {
        "fontFamily": "'Fira Sans', Inter, Helvetica, Arial, sans-serif"
      }
    }
  },
  "echartsOptionsOverridesByChartType": {
    "echarts_timeseries_bar": {
      "series": {
        "itemStyle": {
          "borderRadius": [
            2,
            2,
            0,
            0
          ]
        }
      }
    },
    "echarts_timeseries_line": {
      "series": {
        "lineStyle": {
          "width": 2.5
        }
      }
    },
    "echarts_timeseries_smooth": {
      "series": {
        "lineStyle": {
          "width": 2.5
        }
      }
    },
    "echarts_area": {
      "series": {
        "lineStyle": {
          "width": 2
        }
      }
    },
    "pie": {
      "series": {
        "itemStyle": {
          "borderColor": "#141414",
          "borderWidth": 2
        }
      }
    },
    "treemap_v2": {
      "series": {
        "itemStyle": {
          "borderColor": "#141414",
          "borderWidth": 2,
          "gapWidth": 2
        }
      }
    },
    "sunburst_v2": {
      "series": {
        "itemStyle": {
          "borderColor": "#141414",
          "borderWidth": 2
        }
      }
    }
  }
}
